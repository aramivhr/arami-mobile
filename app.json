{
  "expo": {
    "name": "Arami Portal",
    "slug": "arami-portal",
    "scheme": "aramiportal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aramivhr.portal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Arami Portal with Face ID."
      }
    },
    "android": {
      "package": "com.aramivhr.portal",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Arami Portal with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59E0B",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Arami Portal uses the camera to photograph items during inspections.",
          "photosPermission": "Arami Portal attaches photos to inspection reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
